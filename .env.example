# Public origin of this site, no trailing slash. Used for canonical links, sitemap and share previews.
SITE_URL=https://example.com

# Where the "Sign in" buttons lead: the login page of the ERP web app.
PUBLIC_APP_URL=https://developer-erp-frontend.vercel.app/login

# Optional contacts. A contact block and a "Request a demo" button appear only for the ones you set.
PUBLIC_CONTACT_PHONE=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_TELEGRAM=
PUBLIC_CONTACT_WHATSAPP=
PUBLIC_CONTACT_ADDRESS=

# Optional links to the mobile apps; the badges become links when set.
PUBLIC_APP_ANDROID_URL=
PUBLIC_APP_IOS_URL=

# Optional endpoint for the demo request form (it receives a JSON POST: name, phone, company, type, lang).
# Works with Formspree, a Telegram-bot webhook, or your own API. Without it the form opens a prefilled
# message in Telegram / WhatsApp / email instead (whichever contact is set).
PUBLIC_LEAD_ENDPOINT=

# Optional analytics. Goals: demo_click, demo_submit, login_click.
PUBLIC_YANDEX_METRIKA_ID=
PUBLIC_GA_ID=
